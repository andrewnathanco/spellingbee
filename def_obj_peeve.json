        "syns": [
            {
                "pl": "synonyms",
                "pt": [
                    [
                        "text",
                        "{sc}irritate{/sc} {sc}exasperate{/sc} {sc}nettle{/sc} {sc}provoke{/sc} {sc}rile{/sc} {sc}peeve{/sc} mean to excite a feeling of anger or annoyance. {sc}irritate{/sc} implies an often gradual arousing of angry feelings that may range from mere impatience to rage. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "constant nagging that {it}irritated{/it} me greatly"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}exasperate{/sc} suggests galling annoyance and the arousing of extreme impatience. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "his {it}exasperating{/it} habit of putting off needed decisions"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}nettle{/sc} suggests a sharp but passing annoyance or stinging. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "your pompous attitude {it}nettled{/it} several people"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}provoke{/sc} implies an arousing of strong annoyance that may excite to action. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "remarks made solely to {it}provoke{/it} her"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}rile{/sc} implies inducing an angry or resentful agitation. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "the new work schedules {it}riled{/it} the employees"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}peeve{/sc} suggests arousing fretful often petty or querulous irritation. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "a toddler {it}peeved{/it} at being refused a cookie"
                            }
                        ]
                    ]
                ]
            }
        ]
